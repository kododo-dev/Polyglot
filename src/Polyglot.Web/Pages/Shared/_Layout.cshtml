@using Kododo.Polyglot.Web.Auth
@using Kododo.Polyglot.Web.Pages.Shared
@using System.Security.Claims
@inject PolyglotOptions Polyglot
@{
    var title = ViewData["Title"] as string;
    var bare = ViewData["Bare"] is true;
    var currentPage = ViewContext.RouteData.Values["page"] as string;
    string? Current(string page) => currentPage == page ? "page" : null;
    var canEdit = User.IsInRole(nameof(UserRole.Admin)) || User.IsInRole(nameof(UserRole.Editor));
    var isAdmin = User.IsInRole(nameof(UserRole.Admin));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(title is not null ? $"{title} · Polyglot" : "Polyglot")</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml">
    <script>
        // Before the stylesheet paints: the theme the translation editor saved, else the system's.
        (() => {
            let theme = null;
            try { theme = localStorage.getItem('cultureway.theme'); } catch { }
            if (theme !== 'light' && theme !== 'dark')
                theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
            document.documentElement.dataset.theme = theme;
        })();
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
@if (bare)
{
    <main class="auth-page">@RenderBody()</main>
}
else
{
    <div class="shell">
        <aside class="sidebar" aria-label="Main menu">
            <div class="sidebar-head">
                <a class="brand" href="~/">Polyglot</a>
                <partial name="_ThemeToggle" />
            </div>
            <nav class="nav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="nav-item" href="~/" aria-current="@Current("/Index")">@Icons.Get("home") Overview</a>
                    @if (canEdit)
                    {
                        <a class="nav-item" href="@($"{Context.Request.PathBase}{Polyglot.GetEditorPath()}/")">@Icons.Get("globe") Translations</a>
                    }
                    @if (isAdmin)
                    {
                        <div class="nav-label">Administration</div>
                        <a class="nav-item" asp-page="/Admin/Users" aria-current="@Current("/Admin/Users")">@Icons.Get("users") Users</a>
                        <a class="nav-item" asp-page="/Admin/ApiKeys" aria-current="@Current("/Admin/ApiKeys")">@Icons.Get("key") API keys</a>
                    }
                }
            </nav>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="sidebar-foot">
                    @Icons.Get("user")
                    <a class="user" asp-page="/Account" aria-current="@Current("/Account")">@(User.FindFirstValue("display_name") ?? User.Identity.Name)</a>
                    <form method="post" asp-page="/Logout">
                        <button class="icon-btn" type="submit" title="Sign out" aria-label="Sign out">@Icons.Get("logout")</button>
                    </form>
                </div>
            }
        </aside>
        <div class="backdrop" data-menu-toggle></div>
        <div class="main">
            <header class="topbar">
                <button class="icon-btn menu-button" type="button" data-menu-toggle aria-label="Open menu">@Icons.Get("menu")</button>
                <h1>@title</h1>
                @await RenderSectionAsync("Actions", required: false)
            </header>
            <main class="content">
                <div class="content-inner">@RenderBody()</div>
            </main>
        </div>
    </div>

    <dialog class="dialog" id="confirm-dialog" aria-labelledby="confirm-title">
        <div class="dialog-head" id="confirm-title">Are you sure?</div>
        <div class="dialog-body"><p data-fill="message"></p></div>
        <div class="dialog-foot">
            <button class="btn" type="button" data-close>Cancel</button>
            <button class="btn btn-primary" type="button" data-confirm-ok>Confirm</button>
        </div>
    </dialog>
}
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
