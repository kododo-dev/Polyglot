<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>Latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Kododo</Authors>
    <Company>Kododo</Company>
    <Copyright>Copyright (c) 2026 Kododo</Copyright>
    <RepositoryUrl>https://github.com/kododo-dev/Polyglot</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>Kododo.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>Kododo.$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>

</Project>
