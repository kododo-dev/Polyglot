@page "/admin/users"
@model UsersModel
@using Kododo.Polyglot.Web.Auth
@{
    ViewData["Title"] = "Users";
}
<div class="card">
    <h1>Users</h1>
    @if (Model.Message is not null) { <p class="ok">@Model.Message</p> }
    @foreach (var error in Model.Errors) { <p class="error">@error</p> }
    <table>
        <thead><tr><th>User</th><th>Role</th><th>Actions</th></tr></thead>
        <tbody>
        @foreach (var user in Model.Users)
        {
            <tr>
                <td>
                    @user.Username
                    @if (user.ExternalSubject is not null) { <span class="tag">SSO</span> }
                    @if (user.IsDisabled) { <span class="tag">disabled</span> }
                </td>
                <td>
                    <form method="post" asp-page-handler="Role">
                        <input type="hidden" name="id" value="@user.Id">
                        <select name="role" onchange="this.form.submit()">
                            @foreach (var role in Enum.GetValues<UserRole>())
                            {
                                <option value="@role" selected="@(role == user.Role)">@role</option>
                            }
                        </select>
                    </form>
                </td>
                <td>
                    <form method="post" asp-page-handler="Disabled">
                        <input type="hidden" name="id" value="@user.Id">
                        <input type="hidden" name="disabled" value="@((!user.IsDisabled).ToString().ToLowerInvariant())">
                        <button class="secondary" type="submit">@(user.IsDisabled ? "Enable" : "Disable")</button>
                    </form>
                    @if (user.PasswordHash is not null)
                    {
                        <form method="post" asp-page-handler="ResetPassword">
                            <input type="hidden" name="id" value="@user.Id">
                            <input type="password" name="newPassword" placeholder="New password" autocomplete="new-password">
                            <button class="secondary" type="submit">Reset</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
<div class="card">
    <h2>Add a user</h2>
    <form method="post" asp-page-handler="Create">
        <label for="username">Username</label>
        <input id="username" type="text" asp-for="Input.Username" autocomplete="off">
        <label for="displayName">Display name (optional)</label>
        <input id="displayName" type="text" asp-for="Input.DisplayName" autocomplete="off">
        <label for="password">Password (min @UserService.MinPasswordLength characters)</label>
        <input id="password" type="password" asp-for="Input.Password" autocomplete="new-password">
        <label for="role">Role</label>
        <select id="role" asp-for="Input.Role">
            <option value="@UserRole.Editor">Editor</option>
            <option value="@UserRole.Admin">Admin</option>
        </select>
        <button type="submit">Create user</button>
    </form>
</div>
