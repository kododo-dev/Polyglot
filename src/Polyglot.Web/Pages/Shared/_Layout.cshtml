@{
    var title = ViewData["Title"] as string;
}
@* The pages outside the shell: sign-in and access denied. Everything else is a Way of the shell's panel. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(title is not null ? $"{title} · Polyglot" : "Polyglot")</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml">
    <script>
        // Before the stylesheet paints: the theme chosen here or in the shell (Way.Shell's key), else the system's.
        (() => {
            let theme = null;
            try { theme = localStorage.getItem('way-shell:theme'); } catch { }
            if (theme !== 'light' && theme !== 'dark')
                theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
            document.documentElement.dataset.theme = theme;
        })();
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
<main class="auth-page">@RenderBody()</main>
<script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
