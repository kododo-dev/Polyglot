@page "/admin/api-keys"
@model ApiKeysModel
@using Kododo.Polyglot.Web.Auth
@{
    ViewData["Title"] = "API keys";
}
@if (Model.NewToken is not null)
{
    <div class="card">
        <h2>Key '@Model.NewKeyName' created</h2>
        <p>Copy the key now. It is shown only this once and cannot be shown again; if it is lost, create a new key.</p>
        <div class="token">
            <code id="new-token">@Model.NewToken</code>
            <button class="secondary" type="button" id="copy-token">Copy</button>
        </div>
        <p class="muted">Send it in the <code>X-Api-Key</code> header.</p>
    </div>
    <script>
        document.getElementById('copy-token').addEventListener('click', async e => {
            await navigator.clipboard.writeText(document.getElementById('new-token').textContent);
            e.target.textContent = 'Copied';
        });
    </script>
}
<div class="card">
    <h1>API keys</h1>
    @if (!Model.ApiEnabled)
    {
        <p class="muted">The delivery API is turned off (<code>Polyglot__Api__Enabled=false</code>), so these keys open nothing until it is turned on.</p>
    }
    @if (Model.Message is not null) { <p class="ok">@Model.Message</p> }
    @foreach (var error in Model.Errors) { <p class="error">@error</p> }
    @if (Model.Keys.Count == 0)
    {
        <p class="muted">No API keys yet.</p>
    }
    else
    {
        <table>
            <thead><tr><th>Key</th><th>Created</th><th>Last used</th><th>Expires</th><th>Actions</th></tr></thead>
            <tbody>
            @foreach (var key in Model.Keys)
            {
                <tr>
                    <td>
                        @key.Name <span class="tag">@Model.Status(key)</span><br>
                        <code class="muted">@(ApiKeyService.TokenPrefix + key.KeyId)_...</code>
                        <span class="muted">@key.Scopes</span>
                    </td>
                    <td>@ApiKeysModel.Format(key.CreatedAt)</td>
                    <td>@ApiKeysModel.Format(key.LastUsedAt)</td>
                    <td>@ApiKeysModel.Format(key.ExpiresAt)</td>
                    <td>
                        <form method="post" asp-page-handler="Disabled">
                            <input type="hidden" name="id" value="@key.Id">
                            <input type="hidden" name="disabled" value="@((!key.IsDisabled).ToString().ToLowerInvariant())">
                            <button class="secondary" type="submit">@(key.IsDisabled ? "Enable" : "Disable")</button>
                        </form>
                        <form method="post" asp-page-handler="Delete" data-name="@key.Name"
                              onsubmit="return confirm(`Delete the key '${this.dataset.name}'? Apps using it lose access, and this cannot be undone.`)">
                            <input type="hidden" name="id" value="@key.Id">
                            <button class="secondary" type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
<div class="card">
    <h2>Create a key</h2>
    <form method="post" asp-page-handler="Create">
        <label for="name">Name (what the key is for, e.g. shop-frontend-prod)</label>
        <input id="name" type="text" asp-for="Input.Name" maxlength="@ApiKeyService.MaxNameLength" autocomplete="off">
        <label for="validThrough">Valid through (UTC, optional)</label>
        <input id="validThrough" type="date" asp-for="Input.ValidThrough">
        <button type="submit">Create key</button>
    </form>
</div>
