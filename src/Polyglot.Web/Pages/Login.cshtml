@page "/login"
@model LoginModel
@using Kododo.Polyglot.Web.Pages.Shared
@{
    ViewData["Title"] = "Sign in";
    ViewData["Bare"] = true;
}
<div class="auth-card">
    <partial name="_ThemeToggle" />
    <span class="brand">Polyglot</span>
    <p class="lead">Sign in to manage translations.</p>

    @if (Model.Error is not null)
    {
        <div class="alert alert-error" role="alert">@Icons.Get("alert")<div><p>@Model.Error</p></div></div>
    }

    @if (Model.Demo.Enabled)
    {
        <div class="alert alert-warn" role="status">@Icons.Get("info")<div><p>@Model.Demo.Notice</p></div></div>
        <form method="post" asp-page-handler="Demo" asp-route-returnUrl="@Model.ReturnUrl">
            <button class="btn btn-primary btn-block" type="submit">Try the demo</button>
        </form>
        <p class="hint demo-credentials">Or sign in below as <code>@Model.Demo.Username</code> with the password <code>@Model.Demo.Password</code>.</p>
        <div class="divider">or</div>
    }

    @if (Model.LocalEnabled)
    {
        <form class="form" method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div class="field">
                <label for="username">Username</label>
                <input id="username" type="text" asp-for="Username" autocomplete="username" autofocus required>
            </div>
            <div class="field">
                <label for="password">Password</label>
                <input id="password" type="password" asp-for="Password" autocomplete="current-password" required>
            </div>
            <button class="btn btn-primary btn-block" type="submit">Sign in</button>
        </form>
    }

    @if (Model.OidcName is not null)
    {
        @if (Model.LocalEnabled)
        {
            <div class="divider">or</div>
        }
        <a class="btn btn-block" asp-page-handler="Oidc" asp-route-returnUrl="@Model.ReturnUrl">@Icons.Get("lock") Continue with @Model.OidcName</a>
    }
</div>
